{
  "name": "tapnote-ot-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "TapNote OT as an installable web app (PWA). Local-first; names encrypted on device.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
